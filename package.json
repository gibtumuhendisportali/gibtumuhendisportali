{
  "name": "gibtu-engineering-portal",
  "version": "0.1.0",
  "private": true,
  "description": "GIBTU Engineering Portal — Student and Alumni Network",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @gibtu/web dev",
    "dev:api": "pnpm --filter @gibtu/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
